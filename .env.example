# Credit Risk Intelligence Platform
# Environment Variables Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# General Settings
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# =============================================================================
# Snowflake Configuration
# =============================================================================
SNOWFLAKE_ACCOUNT=your_account.region
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=CREDIT_RISK
SNOWFLAKE_SCHEMA=FEATURES
SNOWFLAKE_ROLE=ANALYST

# =============================================================================
# Databricks Configuration
# =============================================================================
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your_databricks_token
DATABRICKS_CLUSTER_ID=your_cluster_id
DATABRICKS_DELTA_PATH=dbfs:/mnt/credit-risk/delta

# =============================================================================
# MLflow Configuration
# =============================================================================
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=credit-risk-model
MLFLOW_REGISTRY_URI=http://localhost:5000

# =============================================================================
# Kafka Configuration (Optional - for streaming)
# =============================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRANSACTIONS_TOPIC=transactions
KAFKA_CONSUMER_GROUP=credit-risk-consumer

# =============================================================================
# API Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_DEBUG=false

# =============================================================================
# Model Configuration
# =============================================================================
MODEL_VERSION=latest
MODEL_PREDICTION_THRESHOLD=0.5

# =============================================================================
# Feature Store Configuration
# =============================================================================
FEATURE_FRESHNESS_HOURS=24
FEATURE_CACHE_TTL_SECONDS=3600
